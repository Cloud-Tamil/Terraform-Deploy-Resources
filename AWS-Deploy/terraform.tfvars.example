# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored by convention — don't commit real values.

aws_region       = "us-east-1"
project_name     = "basic-vm-stack"
instance_type    = "t3.micro"
key_name         = "my-ec2-keypair"     # must already exist in AWS, or set to null
allowed_ssh_cidr = "203.0.113.5/32"     # replace with YOUR IP/32, never 0.0.0.0/0
root_volume_size = 8
bucket_name      = null                 # leave null to auto-generate a unique name
enable_cpu_alarm = true
cpu_alarm_threshold = 80
